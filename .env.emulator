# Emulator-only values. Loaded by: vite --mode emulator
# No real project, no secrets. Never used by a production build.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=lentera-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lentera-demo
VITE_FIREBASE_STORAGE_BUCKET=lentera-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app-id
VITE_APP_CHECK_DEBUG=0
VITE_USE_EMULATORS=1
VITE_DISABLE_AI=1
