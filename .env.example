# Copy to .env.local and fill from Firebase console > Project settings > Your apps.
# Without these values LENTERA runs in local-only demo mode (no cloud sync, no AI calls).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Score-based reCAPTCHA Enterprise site key for App Check (web).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Set to "1" only for local development; register the debug token in App Check.
VITE_APP_CHECK_DEBUG=0
# Local verification only: point Auth and Firestore at the Firebase emulators.
VITE_USE_EMULATORS=0
# Local verification only: skip AI calls so the manual fallback can be tested.
VITE_DISABLE_AI=0
# Admin access uses Google sign-in only. No shared access code is configured
# here or in the client; seed coordinators/{uid}.region for each coordinator.
